{
  "name": "MathPad",
  "short_name": "MathPad",
  "categories": ["engineering", "productivity", "education"],
  "icons": [
    {
      "src": "images/icon-v2.svg",
      "type": "image/svg+xml",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "images/icon-maskable-v2.svg",
      "type": "image/svg+xml",
      "sizes": "512x512",
      "purpose": "maskable"
    },
    {
      "src": "images/icon-192-v2.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "images/icon-512-v2.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "images/icon-maskable-192-v2.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    },
    {
      "src": "images/icon-maskable-512-v2.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose":"maskable"
    }
  ],
  "id": "/",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#e61f00",
  "description": "MathPad is a web app for engineering math, unit conversion, equations, and plots.",
  "shortcuts" : [
    {
      "name": "New Sheet",
      "url": "/",
      "description": "Open a new window with a blank sheet",
      "icons": [
        { "src": "images/new-sheet-icon-192.png", "sizes": "192x192" },
        { "src": "images/new-sheet-icon-96.png", "sizes": "96x96" }
      ]
    }

  ],
  "launch_handler": {
    "client_mode": "auto"
  },
  "file_handlers": [
    {
      "action": "/open_file",
      "name": "MathPad",
      "accept": {
        "application/json": [ ".epxyz" ]
      },
      "icons": [
        {
          "src": "images/sheet-icon-144.png",
          "sizes": "144x144"
        },
        {
          "src": "images/sheet-icon-192.png",
          "sizes": "192x192"
        },
        {
          "src": "images/sheet-icon-512.png",
          "sizes": "512x512"
        }
      ],
      "launch_type": "multiple-clients"
    }
  ]
}
